# =============================================================================
# .env.example — copy thành .env rồi điền. KHÔNG commit .env.
# Mọi biến đều optional: script nào thiếu key thì bỏ qua phần đó, không crash.
# =============================================================================

# --- PageSpeed Insights / CrUX (MIỄN PHÍ, nên có) ---------------------------
# Tạo: https://console.cloud.google.com/apis/credentials → Create credentials → API key
# Bật: "PageSpeed Insights API"
# Không có key thì quota ẩn danh gần như = 0 → nhận 429 ngay.
PSI_API_KEY=

# --- Google Search Console (read-only là đủ) --------------------------------
# 1. Tạo service account, bật "Google Search Console API"
# 2. Thêm email service account vào GSC property với quyền Restricted
# 3. Trỏ biến này tới file JSON key
GOOGLE_APPLICATION_CREDENTIALS=
GSC_SITE_URL=https://ptemagic.com/

# --- GA4 (chỉ cần khi muốn nối SEO với KPI sign_up) -------------------------
# Dùng chung service account ở trên, thêm quyền "Viewer" vào GA4 property.
GA4_PROPERTY_ID=

# --- DataForSEO (optional — SERP API, keyword volume) -----------------------
# https://app.dataforseo.com → API credentials
# Không có thì dùng GSC + CSV export từ Ahrefs/Semrush thay thế.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# --- Ahrefs (optional — backlink audit) -------------------------------------
# https://ahrefs.com/api/profile
AHREFS_API_TOKEN=

# --- Firecrawl (optional — crawl site render JS) ----------------------------
FIRECRAWL_API_KEY=

# --- GEO / AEO: kiểm tra citation trên AI engines (optional) ----------------
# Chỉ cần nếu chạy skill seo-geo-visibility ở chế độ test citation thật.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
PERPLEXITY_API_KEY=
XAI_API_KEY=
GEMINI_API_KEY=

# --- WordPress REST (chỉ nếu publish thẳng vào cms.ptemagic.com) ------------
WP_URL=https://cms.ptemagic.com
WP_USER=
WP_APP_PASSWORD=

# =============================================================================
# Ghi chú bảo mật
#  * KHÔNG dán key vào chat, vào issue, vào commit.
#  * `.env` đã nằm trong .gitignore của thư mục này.
#  * Service account GSC chỉ cần quyền Restricted/Read-only — đừng cấp Full.
#  * Nếu làm cho khách: dùng service account RIÊNG cho từng khách, thu hồi khi
#    kết thúc hợp đồng. Đừng dùng một key cho mọi dự án.
# =============================================================================
